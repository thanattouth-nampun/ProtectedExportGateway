<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup><ProjectReference Include="../Gateway.Application/Gateway.Application.csproj"/></ItemGroup>
  <ItemGroup><ProjectReference Include="../Gateway.Infrastructure/Gateway.Infrastructure.csproj"/></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.8"/>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8"/>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5"/>
  </ItemGroup>
  <Target Name="BuildClient" BeforeTargets="ComputeFilesToPublish" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec WorkingDirectory="../Gateway.Client" Command="npm ci --ignore-scripts"/>
    <Exec WorkingDirectory="../Gateway.Client" Command="npm run build"/>
    <ItemGroup><Content Include="wwwroot/app/**" CopyToPublishDirectory="PreserveNewest" Exclude="@(Content)"/></ItemGroup>
  </Target>
</Project>
