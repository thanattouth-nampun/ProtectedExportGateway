  "components": {
    "schemas": {
      "CsrfDto": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DocumentDto": {
        "required": [
          "id",
          "title",
          "purpose",
          "owner",
          "filename",
          "version",
          "classification",
          "status",
          "canRequestCopy"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "classification": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "canRequestCopy": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "DocumentPageDto": {
        "required": [
          "items",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentDto"
            }
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "DraftEdit": {
        "required": [
          "title",
          "purpose",
          "requesterObjectIds"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "requesterObjectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "additionalProperties": false
      },
      "OwnerAuditView": {
        "required": [
          "eventType",
          "documentRevision",
          "at",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "eventType": {
            "type": "string"
          },
          "documentRevision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "OwnerDocumentPage": {
        "required": [
          "items",
          "total",
          "skip",
          "pageSize"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OwnerDocumentView"
            }
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "skip": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "OwnerDocumentView": {
        "required": [
          "id",
          "title",
          "purpose",
          "revision",
          "aclRevision",
          "eTag",
          "requesterObjectIds",
          "status",
          "sourceOwnershipStatus",
          "canPublish"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "revision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "aclRevision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "eTag": {
            "type": "string"
          },
          "requesterObjectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "status": {
            "type": "string"
          },
          "sourceOwnershipStatus": {
            "type": "string"
          },
          "canPublish": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "QuarantineVersionView": {
        "required": [
          "id",
          "filename",
          "state",
          "bytes",
          "sha256",
          "uploadedAt",
          "errorCode"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "filename": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "bytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "sha256": {
            "type": [
              "null",
              "string"
            ]
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "errorCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "storageMode": {
            "type": "string",
            "default": "LocalQuarantineSpike"
          },
          "canPublish": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "RequesterOptionDto": {
        "required": [
          "objectId",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "objectId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SessionDto": {
        "required": [
          "tenantId",
          "objectId",
          "displayName",
          "roles",
          "mode",
          "canManageOwnDocuments",
          "canUploadToLocalQuarantine"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "objectId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "type": "string"
          },
          "canManageOwnDocuments": {
            "type": "boolean"
          },
          "canUploadToLocalQuarantine": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "Stream": {
        "type": "string",
        "format": "binary"
      }
    }
  },
  "tags": [
    {
      "name": "Gateway.Web"
    },
    {
      "name": "Own documents"
    },
    {
      "name": "Local quarantine spike"
    }
