  "components": {
    "schemas": {
      "CsrfDto": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DocumentDto": {
        "required": [
          "id",
          "title",
          "purpose",
          "owner",
          "filename",
          "version",
          "classification",
          "status",
          "canRequestCopy"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "classification": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "canRequestCopy": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "DocumentPageDto": {
        "required": [
          "items",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentDto"
            }
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "SessionDto": {
        "required": [
          "tenantId",
          "objectId",
          "displayName",
          "roles",
          "mode"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "objectId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
